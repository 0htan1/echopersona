# ============================================================
# EchoPersona 环境变量模板
#
#   cp .env.example .env
#
# 默认值就是「本机跑起来能用」：development + http://localhost:8080。
# 上线时按文件末尾「生产部署」一节改几个值即可。
# ============================================================

# ---------- 运行环境 ----------
# development：打印请求日志、错误详情可见，适合本机调试。
# production ：启用 HSTS、隐藏内部错误、关闭请求日志。
#
# ⚠ 本机跑请保持 development。若在 http://localhost 上开 production，
#   而 PUBLIC_URL 又是 https，会话 cookie 会带 Secure 属性，
#   浏览器不保存它，表现为「登录成功了却还是未登录」。
NODE_ENV=development

# 监听地址。默认 0.0.0.0，因为容器/托管平台都经反向代理访问，只监听回环会连不上。
# 若前面是本机 Nginx 且希望只让反代访问，可改为 127.0.0.1。
HOST=0.0.0.0
PORT=8080

# 对外可访问的完整地址（含协议），用于生成绝对链接、判断 Cookie 的 Secure 属性
PUBLIC_URL=http://localhost:8080

# ---------- 加密主密钥（可选） ----------
# 用于加密用户填写的 LLM / TTS API Key（AES-256-GCM）。
# 生成方式： openssl rand -hex 32
#
# 留空也可以启动：首次启动会在 DATA_DIR 下生成 .masterkey（权限 0600）并复用。
# 适合不方便注入环境变量的托管平台。
#
# 警告：更换此值会导致已保存的所有 API Key 无法解密，用户需要重新填写。
# 备份数据目录时务必把 .masterkey 一起备份，否则恢复后旧密文解不开。
MASTER_KEY=

# ---------- 数据存储 ----------
# 数据库、上传文件、音频、备份、日志都在这个目录下，首次启动自动创建。
#
# 默认 ./storage。唯一要小心的是「把整个项目目录打包上传」这类托管方式 ——
# 那种情况下本地数据会跟着代码一起上去，此时把 DATA_DIR 指到项目外：
#   DATA_DIR=../echopersona-data npm start
DATA_DIR=./storage

# ---------- 反向代理 ----------
# 是否信任 X-Forwarded-For。仅在确实有 Nginx / CDN 在前面时才开启。
# 直接暴露给公网时必须留空，否则客户端可伪造 IP 绕过限流。
# 可填：1（信任全部）| 数字（信任几跳）| 具体 IP/CIDR 逗号分隔
TRUST_PROXY=

# ---------- 账号 ----------
# 是否开放注册。关闭后只能由已有管理员在后台创建
ALLOW_REGISTRATION=true
# 是否要求邮箱验证后才能登录（需同时配置 SMTP）
REQUIRE_EMAIL_VERIFY=false
# 该邮箱注册的账号自动成为管理员
ADMIN_EMAIL=

# 登录态有效期（天）
SESSION_TTL_DAYS=30

# ---------- 邮件（可选） ----------
# 不配置时，找回密码的链接会打印到服务器日志，由管理员转交用户
# 格式：smtp://user:pass@smtp.example.com:587
SMTP_URL=
MAIL_FROM=no-reply@localhost

# ---------- 上传限制 ----------
MAX_UPLOAD_MB=50
MAX_AUDIO_MB=20
MAX_AUDIO_REF_MB=10
MAX_ZIP_UNCOMPRESSED_MB=200

# ---------- 上游请求 ----------
# 调用 LLM / TTS 的超时时间（毫秒）
UPSTREAM_TIMEOUT_MS=120000

# SSRF 防护：默认拒绝解析到内网 / 回环地址的上游 URL。
# 只有在本地自建服务（如 127.0.0.1:9000 的 breeze-tts-2，
# 或 scripts/mock-upstream.js 的模拟上游）时才设为 1。
# 生产环境如果上游都在公网域名上，请保持关闭。
SSRF_ALLOW_PRIVATE=0

# ---------- 数据保留 ----------
AUDIT_LOG_DAYS=180
TTS_CACHE_DAYS=30
# 自动备份间隔（小时）。0 表示关闭定时备份（仍可手动触发）
BACKUP_INTERVAL_HOURS=24

# ---------- 错误详情 ----------
# 设为 1 时 5xx 响应会带上原始错误信息，仅用于排障。生产请留空。
EXPOSE_ERRORS=

# ---------- 日志 ----------
LOG_LEVEL=info

# ============================================================
# 第三方登录（可选，默认关闭）
# ============================================================
# 留空 = 只用邮箱注册 / 登录。登录页不会画出微信 / 手机号按钮
#（不会出现「点了必然报错」的按钮），项目其余功能完全不受影响。
#
# 填写后启用「微信扫码登录」与「手机号验证码登录」，走 WorkBuddy 云服务做身份认证：
#   浏览器扫码 / 收码 → 拿到云端 accessToken → 服务端回源问「这是谁」→ 换成本站会话
#
# 它**只用于登录身份**，不承载模型调用、数据库或文件存储：
#   · 模型走每个用户在「API 设置」里填的自己的 API Key
#   · 数据库是本地 node:sqlite，文件都在 DATA_DIR 下
#
# 三个值都不是密钥（本来就要下发到浏览器），安全性由服务端 Origin 精确匹配保证。
# EP_CLOUD_ENDPOINT 必须等于用户实际访问的域名，对不上会 401。
EP_CLOUD_ENDPOINT=
EP_CLOUD_PUBLISHABLE_KEY=
EP_CLOUD_OAUTH_RELAY_BASE_URL=

# ============================================================
# 生产部署：把上面这几项改成对应值
# ============================================================
#   NODE_ENV=production
#   PUBLIC_URL=https://your-domain.com
#   TRUST_PROXY=1
#   SSRF_ALLOW_PRIVATE=0        # 除非上游确实在内网
#   MASTER_KEY=                 # 留空自动生成，或显式填 openssl rand -hex 32
#   DATA_DIR=./storage
#
# 完整的 systemd / Nginx / HTTPS / 备份 / 升级步骤见 docs/DEPLOY.md
